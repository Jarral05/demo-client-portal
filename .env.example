# Not needed to run locally: without these, the app uses a temporary in-memory database.
# In production, set these in the host's panel. Never commit real values.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/portal
SESSION_SECRET=a-long-random-string
PUBLIC_URL=https://portal-demo.example.com

# Optional
# TRUST_PROXY=1
# MAX_SANDBOXES=300
